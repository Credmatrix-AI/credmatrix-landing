NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# --- Strapi CMS (blog) ---------------------------------------------------
# Base URL of the Strapi instance, no trailing slash.
# Local: http://localhost:1337 | Strapi Cloud: https://<project>.strapiapp.com
STRAPI_URL=http://localhost:1337

# Optional read-only API token (Strapi → Settings → API Tokens).
# Not needed when the Public role has read access, which the CMS grants on boot.
STRAPI_API_TOKEN=

# Shared secret for the /api/revalidate webhook. Must match the CMS's
# NEXT_REVALIDATE_SECRET. Leave empty to keep the endpoint disabled.
STRAPI_REVALIDATE_SECRET=change-me-to-a-long-random-string
